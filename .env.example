# 复制为 .env 并填入真实值（本地运行用；部署到 Render 时改为在控制台设置同名环境变量）
# 访问口令：好友打开网站时需要输入。留空则首次启动自动生成并写入 ACCESS_CODE.txt
FLC_ACCESS_CODE=

# 飞书自建应用凭证（在 open.feishu.cn 开发者后台「凭证与基础信息」获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 本服务的公网地址（用于拼 OAuth 回调）。本地测试填 http://localhost:8787
PUBLIC_BASE=http://localhost:8787

# 监听端口（默认 8787）
PORT=8787
